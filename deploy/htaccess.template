# .htaccess — Apache (cPanel) para o site estático exportado.
# Gerado por tools/build_cpanel.py. Domínio canônico: {origem}

Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset UTF-8
AddType application/xml .xml
AddType image/svg+xml .svg

# 404 REAL: o Apache serve /404.html mantendo o status 404 (sem soft 404).
ErrorDocument 404 {prefixo}/404.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase {prefixo}/

# HTTPS (compatível com Cloudflare/proxy que envia X-Forwarded-Proto)
RewriteCond %{{HTTPS}} !=on
RewriteCond %{{HTTP:X-Forwarded-Proto}} !https
RewriteRule ^ https://{host}%{{REQUEST_URI}} [L,R=301]

# Host canônico único ({host})
RewriteCond %{{HTTP_HOST}} !^{host_regex}$ [NC]
RewriteRule ^ https://{host}%{{REQUEST_URI}} [L,R=301]

# /pasta/index.html -> /pasta/ (evita URL duplicada)
RewriteCond %{{THE_REQUEST}} \s/+(.*/)?index\.html[\s?]
RewriteRule ^(.*/)?index\.html$ {prefixo}/$1 [L,R=301]

</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"

<FilesMatch "\.html$">
Header always set Content-Language "pt-BR"
Header always set Content-Security-Policy "{csp}"
Header set X-Robots-Tag "{robots}"
Header set Cache-Control "public, max-age=300, s-maxage=600"
</FilesMatch>

# Página de erro nunca declara "index" (LiteSpeed aplica Header set também em respostas 404).
<Files "404.html">
Header set X-Robots-Tag "noindex"
Header always set X-Robots-Tag "noindex"
Header set Cache-Control "public, max-age=60"
</Files>

<FilesMatch "\.(css|svg|png|jpe?g|webp|avif|ico)$">
Header set Cache-Control "public, max-age=86400"
</FilesMatch>

<FilesMatch "\.(txt|xml)$">
Header set Cache-Control "public, max-age=3600"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain application/xml image/svg+xml
</IfModule>
